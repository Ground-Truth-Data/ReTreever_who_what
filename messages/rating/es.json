	"ww_rating_weeds_rows": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} fila",
				"countPlural=*": "{count} filas"
			}
		}
	],
	"ww_rating_weeds_rows_filtered": [
		{
			"declarations": [
				"input shown",
				"input total",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{shown} de {total} fila",
				"totalPlural=*": "{shown} de {total} filas"
			}
		}
	],
	"ww_rating_tally_mean": [
		{
			"declarations": [
				"input count",
				"input shown",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "promedio de {shown} proyecto",
				"countPlural=*": "promedio de {shown} proyectos"
			}
		}
	],
