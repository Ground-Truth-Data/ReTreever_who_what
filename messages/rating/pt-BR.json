	"ww_rating_rank_developer": [
		{
			"declarations": [
				"input place",
				"input total",
				"input shown",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{place} de {shown} desenvolvedor",
				"totalPlural=*": "{place} de {shown} desenvolvedores"
			}
		}
	],
