	"ww_rating_weeds_rows_filtered": [
		{
			"declarations": [
				"input shown",
				"input total",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{shown} de {total} linha",
				"totalPlural=*": "{shown} de {total} linhas"
			}
		}
	],
