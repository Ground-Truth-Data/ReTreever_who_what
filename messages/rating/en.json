{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"ww_rating_out_of": "{rating} out of 100",
	"ww_rating_ordinal_one": "{rank}st",
	"ww_rating_ordinal_two": "{rank}nd",
	"ww_rating_ordinal_few": "{rank}rd",
	"ww_rating_ordinal_other": "{rank}th",
	"ww_rating_rank_developer": [
		{
			"declarations": [
				"input place",
				"input total",
				"input shown",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{place} of {shown} developer",
				"totalPlural=*": "{place} of {shown} developers"
			}
		}
	],
