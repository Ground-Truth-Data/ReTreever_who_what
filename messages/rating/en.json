	"ww_rating_weeds_rows": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} row",
				"countPlural=*": "{count} rows"
			}
		}
	],
	"ww_rating_weeds_rows_filtered": [
		{
			"declarations": [
				"input shown",
				"input total",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{shown} of {total} rows",
				"totalPlural=*": "{shown} of {total} rows"
			}
		}
	],
	"ww_rating_tally_mean": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "mean of {count} project",
				"countPlural=*": "mean of {count} projects"
			}
		}
	]
}
