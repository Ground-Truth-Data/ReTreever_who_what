	"ww_rating_weeds_rows": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} ligne",
				"countPlural=*": "{count} lignes"
			}
		}
	],
	"ww_rating_weeds_rows_filtered": [
		{
			"declarations": [
				"input shown",
				"input total",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{shown} sur {total} ligne",
				"totalPlural=*": "{shown} sur {total} lignes"
			}
		}
	],
	"ww_rating_tally_mean": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "moyenne de {count} projet",
				"countPlural=*": "moyenne de {count} projets"
			}
		}
	]
}
