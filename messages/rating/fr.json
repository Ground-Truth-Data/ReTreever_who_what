{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"ww_rating_out_of": "{rating} sur 100",
	"ww_rating_ordinal_one": "{rank}er",
	"ww_rating_ordinal_two": "{rank}e",
	"ww_rating_ordinal_few": "{rank}e",
	"ww_rating_ordinal_other": "{rank}e",
	"ww_rating_rank_developer": [
		{
			"declarations": [
				"input place",
				"input total",
				"input shown",
				"local totalPlural = total: plural"
			],
			"selectors": [
				"totalPlural"
			],
			"match": {
				"totalPlural=one": "{place} sur {shown} développeur",
				"totalPlural=*": "{place} sur {shown} développeurs"
			}
		}
	],
